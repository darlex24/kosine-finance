# Copy the relevant half into each host's secret store. Do NOT commit a filled-in
# version of this file — it is an example, not a config.

# ---------------------------------------------------------------- backend
ENVIRONMENT=production
# Comma-separated, no trailing slash, https only. The API refuses to start on
# "*", and in production it refuses to start on a localhost origin too.
CORS_ORIGINS=https://your-frontend.vercel.app
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Bypasses RLS entirely. Backend only — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPT_BUCKET=receipts
OPENAI_API_KEY=
CURRENT_TAX_YEAR=2026
# Keep at 1 until the rate limiter has a shared store; each worker keeps its own
# counters, so N workers means N times the configured limits.
WEB_CONCURRENCY=1

# --------------------------------------------------------------- frontend
# Baked in at build time, so a change needs a redeploy, not a restart.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
